{
  "name": "time-sheets-monorepo",
  "private": true,
  "workspaces": [
    "apps/time-sheets",
    "apps/work-forms/client"
  ],
  "scripts": {
    "start:api": "npm --workspace apps/time-sheets run start",
    "test:api": "npm --workspace apps/time-sheets run test",
    "start:work-forms": "npm --workspace apps/work-forms/client run start",
    "build:work-forms": "npm --workspace apps/work-forms/client run build",
    "test:work-forms": "npm --workspace apps/work-forms/client run test"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  },
  "overrides": {
    "schema-utils@4": {
      "ajv": "^8.12.0",
      "ajv-formats": "^2.1.1",
      "ajv-keywords": "^5.1.0"
    },
    "schema-utils@3": {
      "ajv": "^6.12.6",
      "ajv-formats": "^1.5.1",
      "ajv-keywords": "^3.5.2"
    },
    "schema-utils@2": {
      "ajv": "^6.12.6",
      "ajv-keywords": "^3.5.2"
    }
  }
}
